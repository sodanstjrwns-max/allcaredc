[{"term":"임플란트","en":"Dental Implant","desc":"상실된 치아의 뿌리를 대신해 잇몸뼈에 식립하는 인공 치근입니다.","treatment":"implant","initial":"ㅇ"},{"term":"골이식","en":"Bone Graft","desc":"임플란트 식립에 필요한 잇몸뼈가 부족할 때 뼈를 보충하는 술식입니다.","treatment":"implant","initial":"ㄱ"},{"term":"상악동거상술","en":"Sinus Lift","desc":"윗턱 어금니 부위의 뼈가 부족할 때 상악동을 들어 올려 뼈 공간을 확보하는 수술입니다.","treatment":"implant","initial":"ㅅ"},{"term":"픽스처","en":"Fixture","desc":"임플란트의 치근 역할을 하는 나사 형태의 본체입니다.","treatment":"implant","initial":"ㅍ"},{"term":"어버트먼트","en":"Abutment","desc":"픽스처와 보철물을 연결하는 지대주입니다.","treatment":"implant","initial":"ㅇ"},{"term":"골유착","en":"Osseointegration","desc":"임플란트와 잇몸뼈가 단단히 결합하는 현상입니다.","treatment":"implant","initial":"ㄱ"},{"term":"즉시식립","en":"Immediate Implant","desc":"발치와 동시에 임플란트를 식립하는 방법입니다.","treatment":"implant","initial":"ㅈ"},{"term":"지연식립","en":"Delayed Implant","desc":"발치 후 잇몸이 아문 뒤 임플란트를 식립하는 방법입니다.","treatment":"implant","initial":"ㅈ"},{"term":"임플란트주위염","en":"Peri-implantitis","desc":"임플란트 주위 잇몸과 뼈에 생기는 염증입니다.","treatment":"implant","initial":"ㅇ"},{"term":"네비게이션수술","en":"Guided Surgery","desc":"3D 영상으로 제작한 가이드를 이용해 정밀하게 식립하는 방법입니다.","treatment":"implant","initial":"ㄴ"},{"term":"치조골","en":"Alveolar Bone","desc":"치아를 지지하는 턱뼈 부분입니다.","treatment":"implant","initial":"ㅊ"},{"term":"하치조신경","en":"Inferior Alveolar Nerve","desc":"아래턱을 지나는 주요 신경으로 임플란트 시 손상에 주의해야 합니다.","treatment":"implant","initial":"ㅎ"},{"term":"임플란트보철","en":"Implant Prosthesis","desc":"임플란트 위에 장착하는 인공치아 보철물입니다.","treatment":"implant","initial":"ㅇ"},{"term":"올온포","en":"All-on-4","desc":"네 개의 임플란트로 전체 치아를 회복하는 방법입니다.","treatment":"implant","initial":"ㅇ"},{"term":"차폐막","en":"Membrane","desc":"골이식 시 뼈 형성을 돕기 위해 사용하는 막입니다.","treatment":"implant","initial":"ㅊ"},{"term":"치아교정","en":"Orthodontics","desc":"치아와 턱의 위치를 바르게 하는 치료입니다.","treatment":"ortho","initial":"ㅊ"},{"term":"투명교정","en":"Clear Aligner","desc":"투명하고 탈착 가능한 장치를 이용한 교정입니다.","treatment":"ortho","initial":"ㅌ"},{"term":"메탈교정","en":"Metal Braces","desc":"금속 브라켓을 이용한 전통적인 고정식 교정입니다.","treatment":"ortho","initial":"ㅁ"},{"term":"세라믹교정","en":"Ceramic Braces","desc":"치아색과 유사한 세라믹 브라켓을 사용하는 교정입니다.","treatment":"ortho","initial":"ㅅ"},{"term":"설측교정","en":"Lingual Braces","desc":"치아 안쪽에 장치를 부착해 겉으로 보이지 않는 교정입니다.","treatment":"ortho","initial":"ㅅ"},{"term":"브라켓","en":"Bracket","desc":"치아에 부착해 교정력을 전달하는 장치입니다.","treatment":"ortho","initial":"ㅂ"},{"term":"교정용철사","en":"Archwire","desc":"브라켓을 연결해 치아를 이동시키는 철사입니다.","treatment":"ortho","initial":"ㄱ"},{"term":"유지장치","en":"Retainer","desc":"교정 후 치아가 되돌아가지 않도록 유지하는 장치입니다.","treatment":"ortho","initial":"ㅇ"},{"term":"부정교합","en":"Malocclusion","desc":"위아래 치아가 바르게 맞물리지 않는 상태입니다.","treatment":"ortho","initial":"ㅂ"},{"term":"덧니","en":"Crowding","desc":"치아가 겹쳐 나거나 비뚤어진 상태입니다.","treatment":"ortho","initial":"ㄷ"},{"term":"돌출입","en":"Protrusion","desc":"입이 앞으로 튀어나와 보이는 상태입니다.","treatment":"ortho","initial":"ㄷ"},{"term":"개방교합","en":"Open Bite","desc":"어금니를 물어도 앞니가 닿지 않는 교합입니다.","treatment":"ortho","initial":"ㄱ"},{"term":"과개교합","en":"Deep Bite","desc":"윗니가 아랫니를 과도하게 덮는 교합입니다.","treatment":"ortho","initial":"ㄱ"},{"term":"반대교합","en":"Crossbite","desc":"아랫니가 윗니보다 앞으로 나온 교합입니다.","treatment":"ortho","initial":"ㅂ"},{"term":"미니스크류","en":"Mini-screw","desc":"교정 시 고정원으로 사용하는 작은 나사입니다.","treatment":"ortho","initial":"ㅁ"},{"term":"성장기교정","en":"Growth Modification","desc":"성장기 아동의 턱 성장을 이용한 교정입니다.","treatment":"ortho","initial":"ㅅ"},{"term":"발치교정","en":"Extraction Orthodontics","desc":"공간 확보를 위해 치아를 뽑고 진행하는 교정입니다.","treatment":"ortho","initial":"ㅂ"},{"term":"크라운","en":"Crown","desc":"손상된 치아 전체를 덮어 씌우는 보철물입니다.","treatment":"esthetic","initial":"ㅋ"},{"term":"올세라믹","en":"All-Ceramic","desc":"금속 없이 세라믹만으로 제작한 자연스러운 보철입니다.","treatment":"esthetic","initial":"ㅇ"},{"term":"지르코니아","en":"Zirconia","desc":"강도가 높고 심미적인 세라믹 보철 재료입니다.","treatment":"esthetic","initial":"ㅈ"},{"term":"라미네이트","en":"Laminate Veneer","desc":"치아 표면을 얇게 다듬고 얇은 도재를 붙이는 심미 치료입니다.","treatment":"esthetic","initial":"ㄹ"},{"term":"인레이","en":"Inlay","desc":"충치 부위를 본떠 제작한 보철로 메우는 방법입니다.","treatment":"esthetic","initial":"ㅇ"},{"term":"온레이","en":"Onlay","desc":"인레이보다 넓은 부위를 덮는 보철입니다.","treatment":"esthetic","initial":"ㅇ"},{"term":"브릿지","en":"Bridge","desc":"상실된 치아를 인접 치아에 연결해 수복하는 보철입니다.","treatment":"esthetic","initial":"ㅂ"},{"term":"치아미백","en":"Teeth Whitening","desc":"변색된 치아를 밝게 개선하는 치료입니다.","treatment":"whitening","initial":"ㅊ"},{"term":"보철","en":"Prosthesis","desc":"상실되거나 손상된 치아를 인공물로 회복하는 치료입니다.","treatment":"esthetic","initial":"ㅂ"},{"term":"교합","en":"Occlusion","desc":"위아래 치아가 맞물리는 상태입니다.","treatment":"esthetic","initial":"ㄱ"},{"term":"포스트","en":"Post","desc":"신경치료 후 약해진 치아를 보강하는 기둥입니다.","treatment":"esthetic","initial":"ㅍ"},{"term":"코어","en":"Core","desc":"크라운을 씌우기 위한 토대를 만드는 과정입니다.","treatment":"esthetic","initial":"ㅋ"},{"term":"치은성형","en":"Gingivoplasty","desc":"잇몸선을 다듬어 심미성을 개선하는 치료입니다.","treatment":"esthetic","initial":"ㅊ"},{"term":"충치","en":"Dental Caries","desc":"세균에 의해 치아가 썩는 질환입니다.","treatment":"conservative","initial":"ㅊ"},{"term":"신경치료","en":"Root Canal Treatment","desc":"충치가 신경까지 진행되었을 때 신경을 제거하고 소독하는 치료입니다.","treatment":"conservative","initial":"ㅅ"},{"term":"치수","en":"Pulp","desc":"치아 내부의 신경과 혈관이 있는 조직입니다.","treatment":"conservative","initial":"ㅊ"},{"term":"치수염","en":"Pulpitis","desc":"치수에 생긴 염증입니다.","treatment":"conservative","initial":"ㅊ"},{"term":"레진","en":"Composite Resin","desc":"치아색과 유사한 충전 재료입니다.","treatment":"conservative","initial":"ㄹ"},{"term":"아말감","en":"Amalgam","desc":"과거에 많이 쓰인 금속 충전 재료입니다.","treatment":"conservative","initial":"ㅇ"},{"term":"치근단염","en":"Periapical Periodontitis","desc":"치아 뿌리 끝에 생긴 염증입니다.","treatment":"conservative","initial":"ㅊ"},{"term":"치수괴사","en":"Pulp Necrosis","desc":"치수 조직이 죽은 상태입니다.","treatment":"conservative","initial":"ㅊ"},{"term":"근관","en":"Root Canal","desc":"치아 뿌리 내부의 신경관입니다.","treatment":"conservative","initial":"ㄱ"},{"term":"치아우식증","en":"Caries","desc":"충치를 가리키는 의학 용어입니다.","treatment":"conservative","initial":"ㅊ"},{"term":"지각과민","en":"Dentin Hypersensitivity","desc":"치아가 시리고 예민해지는 증상입니다."